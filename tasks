#!/usr/bin/env bash
# Executive Frame Learning Hub: every build, setup and admin task that can run in a terminal.
# Run from the repository folder:   ./tasks help
#
# Uses: Node 22, the Firebase CLI (run through npx if not installed), the Google Cloud CLI (gcloud),
# and Stripe's API through the scripts in scripts/. Secrets are typed by you at a hidden prompt and passed
# straight to the command that needs them; they are never written to disk, shown, or kept in shell history.

set -euo pipefail
cd "$(dirname "$0")"

REGION="australia-southeast1"
DOMAIN="app.executiveframe.co.nz"
CHARLOTTE="hello@charlotteprice.co.nz"
BUDGET_NZD="10"

# ---------- helpers ----------
say()  { printf '\n\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  done: %s\n' "$*"; }
warn() { printf '  note: %s\n' "$*" >&2; }
die()  { printf '\n  stopped: %s\n\n' "$*" >&2; exit 1; }
confirm() { local a; read -r -p "  $1 [y/N] " a; [[ "$a" =~ ^[Yy]$ ]]; }
have() { command -v "$1" >/dev/null 2>&1; }

PROJECT="$(node -e 'try{console.log(require("./.firebaserc").projects.default)}catch(e){console.log("executiveframe-app")}' 2>/dev/null || echo executiveframe-app)"

fb() { if have firebase; then firebase "$@"; else npx -y firebase-tools@latest "$@"; fi; }
need_node()   { have node || die "Node is not installed. Install Node 22 from nodejs.org (or: brew install node@22)."; }
need_gcloud() { have gcloud || die "The Google Cloud CLI is not installed. Install it with: brew install --cask google-cloud-sdk   then run: gcloud init"; }
token() { gcloud auth print-access-token; }

# REST call to a Google API with the signed-in gcloud account. Usage: api METHOD URL [JSON]
api() {
  local method="$1" url="$2" body="${3:-}"
  local args=(-sS -X "$method" -H "Authorization: Bearer $(token)" -H "x-goog-user-project: $PROJECT" -H "Content-Type: application/json" -w '\n%{http_code}')
  [[ -n "$body" ]] && args+=(--data "$body")
  local out code
  out="$(curl "${args[@]}" "$url")"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  if [[ "$code" -ge 300 ]]; then printf '%s\n' "$out" >&2; return 1; fi
  printf '%s\n' "$out"
}
json() { node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const j=JSON.parse(d||'{}');const v=($1);console.log(typeof v==='string'?v:JSON.stringify(v))})"; }

secret_prompt() { # secret_prompt VAR "Prompt"
  local v; read -r -s -p "  $2: " v; echo; [[ -n "$v" ]] || die "Nothing entered."; printf -v "$1" '%s' "$v";
}

# ---------- local work ----------
cmd_doctor() {
  say "Checking tools"
  have node && ok "Node $(node -v)" || warn "Node missing: install Node 22 from nodejs.org"
  have firebase && ok "Firebase CLI $(firebase --version)" || warn "Firebase CLI not installed; tasks use npx firebase-tools instead (or: npm install -g firebase-tools)"
  have gcloud && ok "Google Cloud CLI $(gcloud --version 2>/dev/null | head -1)" || warn "gcloud missing: brew install --cask google-cloud-sdk"
  have java && ok "Java (for the Firestore and Storage emulators)" || warn "Java missing (only needed for emulators): brew install openjdk"
  have git && ok "git" || warn "git missing"
  say "Accounts"
  if have gcloud; then ok "gcloud signed in as: $(gcloud config get-value account 2>/dev/null || echo none)"; fi
  ok "Project in .firebaserc: $PROJECT"
  if have gcloud && gcloud projects describe "$PROJECT" >/dev/null 2>&1; then ok "Project $PROJECT exists and this account can see it"; else warn "Project $PROJECT not found for this account (run ./tasks firebase:project)"; fi
}

cmd_install() { need_node; say "Installing function dependencies"; (cd functions && npm ci); }
cmd_test() { need_node; say "Running function tests"; [[ -d functions/node_modules ]] || (cd functions && npm ci); (cd functions && npm test); }
cmd_preview() { need_node; say "Local preview at http://127.0.0.1:5055 (sample content, no sign in). Ctrl+C to stop."; node scripts/preview.mjs public 5055; }
cmd_emulators() { need_node; [[ -d functions/node_modules ]] || (cd functions && npm ci); say "Starting emulators: open http://127.0.0.1:5000"; fb emulators:start --project "$PROJECT"; }

# ---------- Firebase and Google Cloud ----------
cmd_login() {
  say "Signing in. Use the Google account that should own the project (Sarah's Executive Frame Workspace account), or one with Owner access."
  need_gcloud
  gcloud auth login
  fb login --reauth
}

cmd_firebase_project() {
  need_gcloud
  say "Firebase project: $PROJECT"
  if gcloud projects describe "$PROJECT" >/dev/null 2>&1; then
    ok "Project already exists"
  else
    warn "Project IDs are permanent and global. This creates $PROJECT under: $(gcloud config get-value account 2>/dev/null)"
    [[ -n "${EF_ORG:-}" ]] && warn "Inside Google Workspace organisation $EF_ORG" || warn "To place it inside Sarah's Workspace organisation, rerun with EF_ORG=<organisation id> (gcloud organizations list)"
    confirm "Create project $PROJECT now?" || die "Not created."
    if [[ -n "${EF_ORG:-}" ]]; then
      fb projects:create "$PROJECT" --display-name "Executive Frame" --organization "$EF_ORG"
    else
      fb projects:create "$PROJECT" --display-name "Executive Frame"
    fi
  fi
  if ! fb projects:list 2>/dev/null | grep -q "$PROJECT"; then
    fb projects:addfirebase "$PROJECT"
  fi
  ok "Firebase is on $PROJECT"
}

cmd_firebase_owner() {
  need_gcloud
  local who="${1:-$CHARLOTTE}"
  say "Adding $who as Owner of $PROJECT"
  if gcloud projects add-iam-policy-binding "$PROJECT" --member="user:$who" --role=roles/owner --condition=None >/dev/null; then
    ok "$who is an Owner"
  else
    warn "Google only lets an Owner outside your organisation be invited from the console. Granting Editor and Firebase Admin instead."
    gcloud projects add-iam-policy-binding "$PROJECT" --member="user:$who" --role=roles/editor --condition=None >/dev/null
    gcloud projects add-iam-policy-binding "$PROJECT" --member="user:$who" --role=roles/firebase.admin --condition=None >/dev/null
    ok "$who has Editor and Firebase Admin"
  fi
}

cmd_firebase_billing() {
  need_gcloud
  local acct="${1:-}"
  say "Blaze plan: linking a billing account to $PROJECT"
  if [[ -z "$acct" ]]; then
    gcloud billing accounts list
    read -r -p "  Billing account ID to use (like 0123AB-456CDE-789FGH): " acct
  fi
  [[ -n "$acct" ]] || die "No billing account given. A billing account with Sarah's card must exist first (see docs/setup.md)."
  gcloud billing projects link "$PROJECT" --billing-account="$acct"
  ok "Billing linked"
  say "Budget alert of NZ\$$BUDGET_NZD a month"
  gcloud services enable billingbudgets.googleapis.com --project "$PROJECT"
  if gcloud billing budgets list --billing-account="$acct" --format='value(displayName)' 2>/dev/null | grep -qx "Learning Hub monthly"; then
    ok "Budget already exists"
  else
    gcloud billing budgets create --billing-account="$acct" --display-name="Learning Hub monthly" \
      --budget-amount="${BUDGET_NZD}NZD" --filter-projects="projects/$PROJECT" \
      --threshold-rule=percent=0.5 --threshold-rule=percent=0.9 --threshold-rule=percent=1.0 \
      || warn "Budget not created. If the billing account is not in NZD, rerun with BUDGET_NZD set and the account's currency in docs/setup.md."
    ok "Budget alert emails go to the billing account's administrators"
  fi
}

cmd_firebase_apis() {
  need_gcloud
  say "Turning on the Google APIs the app uses"
  gcloud services enable --project "$PROJECT" \
    firebase.googleapis.com firebasehosting.googleapis.com firestore.googleapis.com firebasestorage.googleapis.com \
    storage.googleapis.com identitytoolkit.googleapis.com cloudfunctions.googleapis.com run.googleapis.com \
    cloudbuild.googleapis.com artifactregistry.googleapis.com eventarc.googleapis.com pubsub.googleapis.com \
    secretmanager.googleapis.com iamcredentials.googleapis.com compute.googleapis.com cloudbilling.googleapis.com
  ok "APIs on"
}

cmd_firebase_firestore() {
  need_gcloud
  say "Firestore (default) database in $REGION"
  if gcloud firestore databases describe --database="(default)" --project "$PROJECT" >/dev/null 2>&1; then
    ok "Already exists"
  else
    gcloud firestore databases create --database="(default)" --location="$REGION" --type=firestore-native --project "$PROJECT"
    ok "Created"
  fi
}

cmd_firebase_storage() {
  need_gcloud
  say "Cloud Storage default bucket in $REGION"
  if api GET "https://firebasestorage.googleapis.com/v1beta/projects/$PROJECT/defaultBucket" >/dev/null 2>&1; then
    ok "Already exists"
  else
    api POST "https://firebasestorage.googleapis.com/v1beta/projects/$PROJECT/defaultBucket" "{\"location\":\"$REGION\"}" >/dev/null
    ok "Created"
  fi
}

cmd_firebase_webapp() {
  say "Firebase web app"
  if fb apps:list WEB --project "$PROJECT" 2>/dev/null | grep -q "Learning Hub"; then
    ok "Already exists"
  else
    fb apps:create WEB "Learning Hub" --project "$PROJECT"
    ok "Created (Hosting serves its settings at /__/firebase/init.json, so nothing to copy)"
  fi
}

cmd_firebase_auth() {
  need_gcloud
  local base="https://identitytoolkit.googleapis.com/admin/v2/projects/$PROJECT"
  say "Authentication: email and password, password policy, authorised domains"
  local cfg domains
  cfg="$(api GET "$base/config")" || die "Authentication is not set up on this project yet. Open Firebase console, Authentication, Get started, once; then rerun this task."
  domains="$(printf '%s' "$cfg" | json "JSON.stringify([...new Set([...(j.authorizedDomains||[]),'$DOMAIN','localhost'])])")"
  api PATCH "$base/config?updateMask=signIn.email.enabled,signIn.email.passwordRequired,authorizedDomains,passwordPolicyConfig" \
    "{\"signIn\":{\"email\":{\"enabled\":true,\"passwordRequired\":true}},
      \"authorizedDomains\":$domains,
      \"passwordPolicyConfig\":{\"passwordPolicyEnforcementState\":\"ENFORCE\",\"forceUpgradeOnSignin\":false,
        \"passwordPolicyVersions\":[{\"customStrengthOptions\":{\"minPasswordLength\":10,\"containsNumericCharacter\":true,\"containsNonAlphanumericCharacter\":true}}]}}" >/dev/null
  ok "Email and password on; 10 characters with a number and a symbol; $DOMAIN authorised"

  idp() { # idp google.com|microsoft.com clientId secret
    local body
    body="$(EF_ID="$2" EF_SECRET="$3" node -e 'console.log(JSON.stringify({enabled:true,clientId:process.env.EF_ID.trim(),clientSecret:process.env.EF_SECRET.trim()}))')"
    if api GET "$base/defaultSupportedIdpConfigs/$1" >/dev/null 2>&1; then
      api PATCH "$base/defaultSupportedIdpConfigs/$1?updateMask=enabled,clientId,clientSecret" "$body" >/dev/null
    else
      api POST "$base/defaultSupportedIdpConfigs?idpId=$1" "$body" >/dev/null
    fi
  }

  say "Microsoft sign in (needs the Entra app registration: ./tasks microsoft:app, or the IDs from the Entra portal)"
  if confirm "Set up Microsoft sign in now?"; then
    local mid msec; read -r -p "  Entra application (client) ID: " mid; secret_prompt msec "Entra client secret (hidden)"
    idp microsoft.com "$mid" "$msec"; ok "Microsoft sign in on"
  fi
  say "Google sign in (needs an OAuth web client ID and secret from Google Cloud, APIs and Services, Credentials)"
  if confirm "Set up Google sign in now?"; then
    local gid gsec; read -r -p "  OAuth client ID: " gid; secret_prompt gsec "OAuth client secret (hidden)"
    idp google.com "$gid" "$gsec"; ok "Google sign in on"
  fi
  warn "Redirect address for both providers: https://$PROJECT.firebaseapp.com/__/auth/handler"
}

cmd_microsoft_app() {
  have az || die "The Azure CLI is not installed: brew install azure-cli   then: az login (with the Microsoft account that will own the app registration)"
  say "Microsoft Entra app registration for 'Continue with Microsoft'"
  local appid
  appid="$(az ad app create --display-name "Executive Frame Learning Hub" --sign-in-audience AzureADandPersonalMicrosoftAccount \
    --web-redirect-uris "https://$PROJECT.firebaseapp.com/__/auth/handler" --query appId -o tsv)"
  ok "Application (client) ID: $appid"
  say "Creating a client secret (valid 24 months). It is shown once; paste it when ./tasks firebase:auth asks."
  az ad app credential reset --id "$appid" --display-name "Firebase" --years 2 --query password -o tsv
  warn "Set a reminder to renew the secret before it expires."
}

cmd_firebase_signing() {
  need_gcloud
  say "Signed download links: Service Account Token Creator for the functions' service account"
  local num sa
  num="$(gcloud projects describe "$PROJECT" --format='value(projectNumber)')"
  sa="${num}-compute@developer.gserviceaccount.com"
  gcloud iam service-accounts add-iam-policy-binding "$sa" --member="serviceAccount:$sa" --role=roles/iam.serviceAccountTokenCreator --project "$PROJECT" >/dev/null
  ok "$sa can sign download links"
}

cmd_firebase_secret() {
  say "Stripe key for the functions (Secret Manager). Paste the restricted key when asked; it is not shown."
  fb functions:secrets:set STRIPE_SECRET_KEY --project "$PROJECT"
  ok "Saved. Functions pick it up on the next deploy."
}

cmd_firebase_domain() {
  need_gcloud
  say "Custom domain $DOMAIN on Firebase Hosting"
  local url="https://firebasehosting.googleapis.com/v1beta1/projects/$PROJECT/sites/$PROJECT/customDomains"
  api GET "$url/$DOMAIN" >/dev/null 2>&1 || api POST "$url?customDomainId=$DOMAIN" "{}" >/dev/null
  say "DNS records to add where executiveframe.co.nz DNS is managed (may take a minute to appear; rerun to refresh):"
  api GET "$url/$DOMAIN" | json "((j.requiredDnsUpdates&&j.requiredDnsUpdates.desired)||[]).flatMap(s=>s.records||[]).map(r=>r.type+'  '+r.domainName+'  '+r.rdata).join('\n')||'Not ready yet: run ./tasks firebase:domain again shortly.'"
}

cmd_firebase_all() {
  cmd_firebase_project
  cmd_firebase_owner "$CHARLOTTE"
  cmd_firebase_billing "${1:-}"
  cmd_firebase_apis
  cmd_firebase_firestore
  cmd_firebase_storage
  cmd_firebase_webapp
  cmd_firebase_signing
  cmd_firebase_auth
  say "Firebase set up. Next: ./tasks firebase:secret, then ./tasks deploy"
}

# ---------- Stripe ----------
stripe_key() { [[ -n "${STRIPE_SECRET_KEY:-}" ]] || secret_prompt STRIPE_SECRET_KEY "Stripe secret key for Sarah's Executive Frame account, test mode sk_test_... (hidden)"; export STRIPE_SECRET_KEY; }
cmd_stripe_prices() { need_node; [[ -d functions/node_modules ]] || (cd functions && npm ci); stripe_key; say "Stripe products and prices"; node scripts/stripe-setup.mjs "$@"; }
cmd_stripe_portal() { need_node; [[ -d functions/node_modules ]] || (cd functions && npm ci); stripe_key; say "Stripe customer portal"; node scripts/stripe-portal.mjs "$@"; }
cmd_stripe_check() { need_node; [[ -d functions/node_modules ]] || (cd functions && npm ci); stripe_key; say "Checking Stripe"; node scripts/stripe-check.mjs; }

# ---------- Content and organisations ----------
cmd_org_add() {
  need_node; need_gcloud
  [[ -d functions/node_modules ]] || (cd functions && npm ci)
  gcloud auth application-default print-access-token >/dev/null 2>&1 || gcloud auth application-default login
  GCLOUD_PROJECT="$PROJECT" node scripts/add-organisation.mjs "$@"
}
cmd_upload() { # upload a workbook: ./tasks upload <local.pdf> <arm|all>
  need_gcloud
  local file="${1:-}" arm="${2:-}"
  [[ -f "$file" && -n "$arm" ]] || die "Usage: ./tasks upload <file.pdf> <arm or all>"
  local name; name="$(basename "$file" | tr '[:upper:] ' '[:lower:]-')"
  local bucket; bucket="$(api GET "https://firebasestorage.googleapis.com/v1beta/projects/$PROJECT/defaultBucket" | json 'j.bucket&&j.bucket.name||""')"
  [[ -n "$bucket" ]] || bucket="$PROJECT.firebasestorage.app"
  gcloud storage cp "$file" "gs://$bucket/library/$arm/$name" --content-type=application/pdf
  ok "Uploaded. Use this path in the topic file: library/$arm/$name"
}

# ---------- Deploy ----------
cmd_deploy() {
  need_node
  cmd_test
  say "Deploying hosting, functions, Firestore rules and Storage rules to $PROJECT"
  confirm "Deploy now?" || die "Not deployed."
  fb deploy --only hosting,functions:learning,firestore,storage --project "$PROJECT"
}
cmd_deploy_site() { say "Deploying the site only (pages and content)"; fb deploy --only hosting --project "$PROJECT"; }
cmd_deploy_functions() { cmd_test; say "Deploying functions only"; fb deploy --only functions:learning --project "$PROJECT"; }
cmd_deploy_rules() { say "Deploying Firestore and Storage rules only"; fb deploy --only firestore,storage --project "$PROJECT"; }
cmd_logs() { fb functions:log --project "$PROJECT" "$@"; }

cmd_help() {
  cat <<EOF

Executive Frame Learning Hub tasks (project: $PROJECT)

  Local
    ./tasks doctor                 Check tools and which account is signed in
    ./tasks install                Install function dependencies
    ./tasks test                   Run the function tests
    ./tasks preview                Local preview with sample content (no sign in)
    ./tasks emulators              Full local run with the Firebase emulators

  Google and Firebase (in this order; ./tasks firebase:all runs them together)
    ./tasks login                  Sign in to gcloud and the Firebase CLI
    ./tasks firebase:project       Create the project and add Firebase (asks first)
    ./tasks firebase:owner [email] Add Charlotte (default) as Owner
    ./tasks firebase:billing [id]  Link the billing account and add a NZ\$$BUDGET_NZD monthly budget alert
    ./tasks firebase:apis          Turn on the APIs the app uses
    ./tasks firebase:firestore     Create the Firestore database in $REGION
    ./tasks firebase:storage       Create the Storage bucket in $REGION
    ./tasks firebase:webapp        Register the web app
    ./tasks firebase:signing       Let the functions sign download links
    ./tasks microsoft:app          Create the Microsoft Entra app registration (Azure CLI)
    ./tasks firebase:auth          Email and password, password policy, domains, Microsoft and Google sign in
    ./tasks firebase:secret        Save the Stripe key in Secret Manager (you paste it, hidden)
    ./tasks firebase:domain        Connect $DOMAIN and print the DNS records

  Stripe (Sarah's Executive Frame account; test key first)
    ./tasks stripe:prices --monthly C --annual C --partner-monthly C --partner-annual C
                                   Create products and prices (amounts in cents, GST included)
    ./tasks stripe:portal          Set up the customer portal (cancel at period end, card, monthly and annual)
    ./tasks stripe:check           Check prices, portal and key mode

  Running the app
    ./tasks deploy                 Test, then deploy everything (asks first)
    ./tasks deploy:site            Pages and content only
    ./tasks deploy:functions       Functions only
    ./tasks deploy:rules           Firestore and Storage rules only
    ./tasks logs                   Function logs
    ./tasks org:add --id ID --name "Name" --domains a.co.nz --seats 20 --contract-end 2027-06-30
                                   Add an organisation's prepaid places (prints the access code once)
    ./tasks upload file.pdf arm    Upload a workbook to library/<arm>/

  Steps with no command line route are listed in docs/setup.md.

EOF
}

case "${1:-help}" in
  doctor) cmd_doctor ;;
  install) cmd_install ;;
  test) cmd_test ;;
  preview) cmd_preview ;;
  emulators) cmd_emulators ;;
  login) cmd_login ;;
  firebase:project) cmd_firebase_project ;;
  firebase:owner) shift; cmd_firebase_owner "$@" ;;
  firebase:billing) shift; cmd_firebase_billing "$@" ;;
  firebase:apis) cmd_firebase_apis ;;
  firebase:firestore) cmd_firebase_firestore ;;
  firebase:storage) cmd_firebase_storage ;;
  firebase:webapp) cmd_firebase_webapp ;;
  firebase:signing) cmd_firebase_signing ;;
  firebase:auth) cmd_firebase_auth ;;
  firebase:secret) cmd_firebase_secret ;;
  firebase:domain) cmd_firebase_domain ;;
  firebase:all) shift; cmd_firebase_all "$@" ;;
  microsoft:app) cmd_microsoft_app ;;
  stripe:prices) shift; cmd_stripe_prices "$@" ;;
  stripe:portal) shift; cmd_stripe_portal "$@" ;;
  stripe:check) cmd_stripe_check ;;
  org:add) shift; cmd_org_add "$@" ;;
  upload) shift; cmd_upload "$@" ;;
  deploy) cmd_deploy ;;
  deploy:site) cmd_deploy_site ;;
  deploy:functions) cmd_deploy_functions ;;
  deploy:rules) cmd_deploy_rules ;;
  logs) shift; cmd_logs "$@" ;;
  help|-h|--help) cmd_help ;;
  *) cmd_help; die "Unknown task: $1" ;;
esac
